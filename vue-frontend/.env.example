# ─────────────────────────────────────────────────────────────
# API Gateway — 브라우저가 접근하는 주소 하나로 통일합니다.
#   · api-gateway 의 server.port (application.yml) = 8080
#   · docker-compose.yml 의 포트 매핑              = 8080:8080
#   · auth-server 가 발급하는 토큰의 issuer         = http://localhost:8080
# 위 셋과 반드시 같아야 합니다. 포트를 바꾸면 이 값만 고치면 됩니다.
# (vite.config.js 의 프록시도 이 값을 읽습니다)
# ─────────────────────────────────────────────────────────────
VITE_GATEWAY_URL=http://localhost:8080

# OAuth2 클라이언트 — auth-server 의 AuthorizationServerConfig 등록값과 일치해야 합니다
VITE_CLIENT_ID=web-client
VITE_CLIENT_SECRET=web-secret

# 콜백 주소 — auth-server 에 하드코딩되어 있어 바꿀 수 없습니다.
# 개발 서버 포트도 이 값에서 가져옵니다 (vite.config.js).
VITE_REDIRECT_URI=http://localhost:3000/callback
