# ─────────────────────────────────────────────────────────────
# API Gateway — 브라우저가 접근하는 주소 하나로 통일합니다.
#   · api-gateway 의 server.port (application.yml) = 8080
#   · docker-compose.yml 의 포트 매핑              = 8080:8080
#   · auth-server 가 발급하는 토큰의 issuer         = http://localhost:8080
# 위 셋과 반드시 같아야 합니다. 포트를 바꾸면 이 값만 고치면 됩니다.
# (vite.config.js 의 프록시도 이 값을 읽습니다)
# ─────────────────────────────────────────────────────────────
VITE_GATEWAY_URL=http://localhost:8080

# OAuth2 클라이언트 — auth-server 의 AuthorizationServerConfig 등록값과 일치해야 합니다
VITE_CLIENT_ID=web-client
VITE_CLIENT_SECRET=web-secret

# 콜백 주소 — auth-server 에 하드코딩되어 있어 바꿀 수 없습니다.
# 개발 서버 포트도 이 값에서 가져옵니다 (vite.config.js).
VITE_REDIRECT_URI=http://localhost:3000/callback

# ─────────────────────────────────────────────────────────────
# AI 검색 (선택) — Firebase AI Logic + Gemini
#   검색창의 문장을 우리 필터 축(기간·지역·분야·예산)으로 옮기는 데만 씁니다.
#   비워 두면 규칙 기반 파서로 동작하므로, 없어도 검색은 그대로 됩니다.
#
#   설정 방법
#     1. Firebase Console 에서 프로젝트 생성
#     2. AI Logic → Get started → provider 를 Gemini Developer API 로 선택
#        (Spark 무료 플랜 유지, 결제 연결 불필요)
#     3. 프로젝트 설정 → 내 앱 → 웹 앱 추가 → 아래 네 값 복사
#     4. App Check 를 켜서 허가되지 않은 호출을 막습니다
#
#   아래 값들은 비밀키가 아니라 공개 식별자입니다. 실제 호출 권한은
#   App Check 가 통제하므로 Gemini API 키를 번들에 넣지 않습니다.
# ─────────────────────────────────────────────────────────────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# 모델 ID 는 Firebase 콘솔이 안내하는 현재 Flash 계열 값을 넣으세요
# # App Check 사이트 키 (필수)
#   없으면 호출이 403 으로 막힙니다:
#   "This AI Logic Project is inactive. Please complete onboarding and enable App Check"
#
#   v3 (권장 · 결제 계정 불필요)
#     https://www.google.com/recaptcha/admin 에서 reCAPTCHA v3 키 생성
#     도메인에 localhost 추가 → 사이트 키·비밀 키를 Firebase App Check 에 등록
#   enterprise
#     GCP 에서 키를 만들며 결제 계정을 요구합니다.
VITE_FIREBASE_APPCHECK_PROVIDER=v3
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_GEMINI_MODEL=
